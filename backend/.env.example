# Copy to .env and fill in. Never commit the real .env.

# Local port. Vercel ignores this and routes requests to the function instead.
PORT=5000

# MongoDB Atlas connection string, with the password filled in and a database
# name on the end, e.g. mongodb+srv://user:password@cluster.mongodb.net/finscope
MONGO_URI=

# Any long random string. Change it and every existing login token stops working.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Sites allowed to call this API, comma separated and with no trailing slash.
# Add the deployed front end here once Vercel gives you its URL.
CLIENT_URL=http://localhost:5173

# The FastAPI market data service.
MARKET_SERVICE_URL=http://localhost:8000
